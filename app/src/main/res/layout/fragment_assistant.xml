<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E2E"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#2E2E3E">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖 AI Travel Assistant"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ask me anything about travel!"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

    <!-- Chat Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false" />

    <!-- Suggested Questions -->
    <HorizontalScrollView
        android:id="@+id/suggestionsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:padding="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/suggestion1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Best time to visit Bali?"
                android:textColor="#FFFFFF"
                android:background="#2E2E3E"
                android:padding="10dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/suggestion2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top destinations in Asia?"
                android:textColor="#FFFFFF"
                android:background="#2E2E3E"
                android:padding="10dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/suggestion3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Budget travel tips?"
                android:textColor="#FFFFFF"
                android:background="#2E2E3E"
                android:padding="10dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/suggestion4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What to pack for Europe?"
                android:textColor="#FFFFFF"
                android:background="#2E2E3E"
                android:padding="10dp"
                android:layout_marginEnd="8dp" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Input Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#2E2E3E">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1E1E2E"
            android:hint="Ask about travel..."
            android:textColorHint="#888888"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:inputType="textMultiLine"
            android:maxLines="3" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#6C63FF"
            android:src="@android:drawable/ic_menu_send"
            android:layout_marginStart="8dp"
            android:contentDescription="Send"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout>